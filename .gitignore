dist/
build/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets — never commit real values
.env
# .env.example is intentionally tracked (it has no real values)

# Identity file — may contain real user→role mappings
identities.yaml
# identities.example.yaml is intentionally tracked

# ML model cache (can be hundreds of GB)
.cache/
huggingface/

